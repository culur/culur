{
  "name": "@culur/monorepo",
  "version": "0.0.0",
  "description": "Culur's Monorepo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/culur/culur.git"
  },
  "bugs": {
    "url": "https://github.com/culur/culur/issues"
  },
  "homepage": "https://github.com/culur/culur#readme",
  "author": "culur <culur.net@gmail.com>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "💻 ----- DEV ----- 💻": "",
    "dev:logger": "nx dev logger",
    "dev:zod": "nx dev generate-zod",
    "🏗️ ----- GEN, BUILD, CLEAN, TEST ----- 🏗️": "",
    "gen": "nx run-many -t gen --exclude monorepo",
    "build": "nx run-many -t build --exclude monorepo",
    "clean": "nx run-many -t clean --exclude monorepo",
    "test": "nx run-many -t test --exclude monorepo",
    "🦋 ----- CHANGESET ----- 🦋": "",
    "changeset": "changeset",
    "changeset:publish": "changeset publish",
    "changeset:version": "changeset version && pnpm install --no-frozen-lockfile",
    "🧹 ----- LINT ----- 🧹": "",
    "es-config": "eslint-config-inspector",
    "lint": "nx run-many -t lint:all -p monorepo",
    "lint:md": "nx run lint:md",
    "lint:es": "nx run lint:es",
    "lint:css": "nx run lint:css",
    "lint:prettier": "nx run lint:prettier",
    "🧹 ----- FIX ----- 🧹": "",
    "fix": "nx run-many -t fix:all -p monorepo --parallel 1",
    "fix:md": "nx run fix:md",
    "fix:es": "nx run fix:es",
    "fix:css": "nx run fix:css",
    "fix:prettier": "nx run fix:prettier",
    "🔃 ----- LIFE CYCLE ----- 🔃": "",
    "prepare": "husky",
    "prepack": "pinst --disable",
    "postpack": "pinst --enable"
  },
  "volta": {
    "node": "24.18.0",
    "pnpm": "11.17.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": "11.17.0"
  },
  "packageManager": "pnpm@11.17.0",
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@culur/changesets-changelog-github": "workspace:*",
    "@culur/config-eslint": "workspace:*",
    "@culur/config-prettier": "workspace:*",
    "@culur/config-stylelint": "workspace:*",
    "@culur/config-typescript": "workspace:*",
    "@eslint-react/eslint-plugin": "^5.18.0",
    "@eslint/config-inspector": "^3.1.0",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "markdownlint": "^0.41.1",
    "markdownlint-cli2": "^0.23.1",
    "nx": "22.7.7",
    "pinst": "^3.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-embed": "^0.5.1",
    "prettier-plugin-multiline-arrays": "^4.1.11",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rimraf": "^6.1.3",
    "stylelint": "^17.14.1",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
