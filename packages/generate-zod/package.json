{
  "name": "@culur/generate-zod",
  "version": "3.0.2",
  "description": "Culur's generate-zod",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/culur/culur.git",
    "directory": "packages/generate-zod"
  },
  "bugs": {
    "url": "https://github.com/culur/culur/issues"
  },
  "homepage": "https://github.com/culur/culur/tree/main/packages/generate-zod#readme",
  "author": "culur <culur.net@gmail.com>",
  "license": "MIT",
  "keywords": [
    "culur",
    "zod",
    "generate"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./is-valid-against-schema": {
      "import": {
        "types": "./dist/is-valid-against-schema.d.mts",
        "default": "./dist/is-valid-against-schema.mjs"
      },
      "require": {
        "types": "./dist/is-valid-against-schema.d.cts",
        "default": "./dist/is-valid-against-schema.cjs"
      }
    }
  },
  "files": [
    "!**/*.test.*",
    "!src/__tests__/**/*",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "dist",
    "src"
  ],
  "volta": {
    "extends": "../../package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "async": "^3.2.6",
    "es-toolkit": "^1.50.0",
    "ts-to-zod": "^5.1.0"
  },
  "devDependencies": {
    "@culur/config-tsdown": "workspace:*",
    "@culur/config-typescript": "workspace:*",
    "@culur/logger": "workspace:*",
    "@types/async": "^3.2.25",
    "ink": "^6.8.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.9.3",
    "zod": "^4.4.3",
    "zx": "^8.8.5"
  },
  "peerDependencies": {
    "@culur/logger": ">=1.9.2",
    "@types/node": "*",
    "dedent": "*",
    "typescript": ">=5.7",
    "zod": "^4.0.0"
  }
}
