{
  "name": "@culur/logger",
  "version": "1.9.2",
  "description": "Culur's logger",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/culur/culur.git",
    "directory": "packages/logger"
  },
  "bugs": {
    "url": "https://github.com/culur/culur/issues"
  },
  "homepage": "https://github.com/culur/culur/tree/main/packages/logger#readme",
  "author": "culur <culur.net@gmail.com>",
  "license": "MIT",
  "keywords": [
    "culur",
    "logger"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "!**/*.test.*",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "dist",
    "src"
  ],
  "volta": {
    "extends": "../../package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "async": "^3.2.6",
    "chalk": "^5.6.2",
    "dedent": "^1.7.2",
    "es-toolkit": "^1.53.1",
    "figures": "^6.1.0",
    "ink": "^6.8.0",
    "ink-spinner": "^5.0.0",
    "ink-syntax-highlight": "^2.0.2",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "string-width": "^8.3.0",
    "type-fest": "^5.10.0"
  },
  "devDependencies": {
    "@culur/config-eslint": "workspace:*",
    "@culur/config-tsdown": "workspace:*",
    "@culur/config-typescript": "workspace:*",
    "@types/async": "^3.2.26",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "prettier-plugin-embed": "^0.8.2",
    "react-devtools": "^7.0.1",
    "react-devtools-core": "^7.0.1"
  }
}
