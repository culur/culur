    "prettier-plugin-tailwindcss": "^0.8.1",
    "remark": "^15.0.1",
    "remark-parse": "^11.0.0",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "prettier": ">=3.0.0",
    "prettier-plugin-tailwindcss": ">=0.6.0"
