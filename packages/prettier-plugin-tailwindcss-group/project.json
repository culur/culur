{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "prettier-plugin-tailwindcss-group",
  "projectType": "library",
  "root": "packages/prettier-plugin-tailwindcss-group",
  "sourceRoot": "packages/prettier-plugin-tailwindcss-group/src",
  "targets": {
    //? 🏗️ ----- ----- ----- BUILD ----- ----- ----- 🏗️ ?//
    "build": {
      "command": "tsdown",
      "dependsOn": ["^build"],
      "inputs": [
        "{workspaceRoot}/.gitignore",
        "{projectRoot}/src/**/*",
        "{projectRoot}/tsdown.config.ts",
        "{projectRoot}/package.json",
        "{projectRoot}/tsconfig.json",
        "!{projectRoot}/**/*.md",
        "!{projectRoot}/**/*.test.ts"
      ],
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },

    //? 🧹 ----- ----- ----- CLEAN ----- ----- ----- 🧹 ?//
    "clean": {
      "command": "rimraf dist coverage"
    },

    //? 🧪 ----- ----- ----- TEST ----- ----- ----- 🧪 ?//
    "test:tsc": {
      "command": "tsc --noEmit",
      "dependsOn": ["build", "^build"],
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/scripts/**/*",
        "{projectRoot}/*.{ts,mts,cts,tsx}",
        "{projectRoot}/tsconfig.json"
      ],
      "cache": true
    },
    "test:vitest": {
      "command": "vitest run",
      "dependsOn": [
        "build",
        "^build",
        { "projects": "config-vite", "target": "build" }
      ],
      "inputs": [
        "{workspaceRoot}/.gitignore",
        "{projectRoot}/src/**/*",
        "{projectRoot}/scripts/**/*",
        "{projectRoot}/*.{ts,mts,cts,tsx}",
        "{projectRoot}/package.json",
        "{projectRoot}/tsconfig.json",
        "!{projectRoot}/coverage/**/*",
        "!{projectRoot}/dist/**/*"
      ],
      "outputs": ["{projectRoot}/coverage"],
      "cache": true
    },
    "test": {
      "dependsOn": ["test:tsc", "test:vitest"]
    },

    //? 🧹 ----- ----- ----- LINT ----- ----- ----- 🧹 ?//
    "lint:prettier": {
      "command": "prettier . --check",
      "dependsOn": [{ "projects": "config-prettier", "target": "build" }],
      "inputs": [
        "{projectRoot}/.prettierignore",
        "{projectRoot}/.prettierrc.mjs",
        "{projectRoot}/**/*",
        "!{projectRoot}/coverage/**/*",
        "!{projectRoot}/dist/**/*",
        "{workspaceRoot}/pnpm-lock.yaml"
      ],
      "cache": true
    },

    //? 🧹 ----- ----- ----- FIX ----- ----- ----- 🧹 ?//
    "fix:prettier": {
      "command": "prettier . --write",
      "dependsOn": [{ "projects": "config-prettier", "target": "build" }]
    }
  }
}
