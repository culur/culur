{
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "name": "monorepo",
  "targets": {
    //? 💻 ----- ----- ----- DEV ----- ----- ----- 💻 ?//
    "dev:logger": { "dependsOn": [{ "projects": "logger", "target": "dev" }] },
    "dev:zod": {
      "dependsOn": [{ "projects": "generate-zod", "target": "dev" }]
    },

    //? 🏗️ ----- ----- ----- GEN, BUILD, CLEAN ----- ----- ----- 🏗️ ?//
    "gen": { "dependsOn": [{ "projects": "*", "target": "gen" }] },
    "build": { "dependsOn": [{ "projects": "*", "target": "build" }] },
    "clean": { "dependsOn": [{ "projects": "*", "target": "clean" }] },

    //? 🧹 ----- ----- ----- LINT ----- ----- ----- 🧹 ?//
    "lint:md": {
      "command": "markdownlint-cli2 .",
      "dependsOn": [{ "projects": "*", "target": "lint:md" }],
      "inputs": [
        "{workspaceRoot}/**/.markdownlint-cli2.yaml",
        "{projectRoot}/**/*.md"
      ],
      "cache": true
    },
    "lint:es": {
      "command": "eslint",
      "dependsOn": [
        { "projects": "config-eslint", "target": "build" },
        { "projects": "*", "target": "lint:es" }
      ],
      "inputs": [
        "{workspaceRoot}/eslint.config.mts",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/**/*.ts",
        "{workspaceRoot}/**/*.mts",
        "{workspaceRoot}/**/*.json",
        "!{workspaceRoot}/packages/**/*"
      ],
      "cache": true
    },
    "lint:css": {
      "command": "stylelint '**/*.{vue,css,scss}' --allow-empty-input",
      "dependsOn": [
        { "projects": "config-stylelint", "target": "build" },
        { "projects": "*", "target": "lint:css" }
      ],
      "inputs": [
        "{workspaceRoot}/.stylelintignore",
        "{workspaceRoot}/.stylelintrc",
        "{workspaceRoot}/**/*.(vue|css|scss)"
      ],
      "cache": true
    },
    "lint:prettier": {
      "command": "prettier . --check",
      "dependsOn": [
        { "projects": "config-prettier", "target": "build" },
        { "projects": "*", "target": "lint:prettier" }
      ],
      "inputs": [
        "{projectRoot}/.prettierignore",
        "{projectRoot}/.prettierrc.mjs",
        "{projectRoot}/**/*",
        "{workspaceRoot}/pnpm-lock.yaml",

        "!{workspaceRoot}/packages/logger/**/*",
        "!{workspaceRoot}/packages/prettier-plugin-tailwindcss-group/**/*"
      ],
      "cache": true
    },
    "lint:all": {
      "dependsOn": [{ "projects": "*", "target": "lint:*" }],
      "cache": true
    },
    "lint": {
      "dependsOn": ["lint:all"]
    },

    //? 🧹 ----- ----- ----- FIX ----- ----- ----- 🧹 ?//
    "fix:md": {
      "command": "markdownlint-cli2 . --fix",
      "dependsOn": [
        { "projects": "*", "target": "fix:md" } //
      ]
    },
    "fix:es": {
      "command": "eslint --fix",
      "dependsOn": [
        { "projects": "config-eslint", "target": "build" },
        { "projects": "*", "target": "fix:prettier" }
      ]
    },
    "fix:css": {
      "command": "stylelint '**/*.{vue,css,scss}' --allow-empty-input --fix",
      "dependsOn": [
        { "projects": "config-stylelint", "target": "build" },
        { "projects": "*", "target": "fix:css" }
      ]
    },
    "fix:prettier": {
      "command": "prettier . --write",
      "dependsOn": [
        { "projects": "config-prettier", "target": "build" },
        { "projects": "*", "target": "fix:prettier" }
      ]
    },
    "fix:all": {
      "dependsOn": [{ "projects": "*", "target": "fix:*" }]
    },
    "fix": {
      "dependsOn": ["fix:all"]
    },

    //? 🧪 ----- ----- ----- TEST ----- ----- ----- 🧪 ?//
    "test": {
      "dependsOn": [{ "projects": "*", "target": "test*" }]
    }
  }
}
